# Production backend.
EXPO_PUBLIC_API_BASE_URL=https://fobssms.com/api
EXPO_PUBLIC_WEB_BASE_URL=https://fobssms.com

# Local development: swap in your machine's LAN IP so a phone on the same wifi
# can reach the dev server. `php artisan serve --host=0.0.0.0` is required for
# it to be reachable from anything other than the Mac itself.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.100.226:8000/api
#   EXPO_PUBLIC_WEB_BASE_URL=http://192.168.100.226:8000
#
# app.config.js reads these at BUILD time, so restart with `npx expo start -c`
# after changing them — a running dev server keeps the old values.
